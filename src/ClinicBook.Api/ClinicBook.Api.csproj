<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>clinicbook-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Api is the composition root, so it references Infrastructure only to call AddInfrastructure(). -->
    <ProjectReference Include="..\ClinicBook.Application\ClinicBook.Application.csproj" />
    <ProjectReference Include="..\ClinicBook.Infrastructure\ClinicBook.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Lets `dotnet ef` use this project as the startup project for migrations. Not shipped at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

</Project>
