<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>clinicbook-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Api is the composition root, so it references Infrastructure only to call AddInfrastructure(). -->
    <ProjectReference Include="..\ClinicBook.Application\ClinicBook.Application.csproj" />
    <ProjectReference Include="..\ClinicBook.Infrastructure\ClinicBook.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
    <!-- Pinned above the transitive 2.0.0, which has a known vulnerability (NU1903). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.*" />
  </ItemGroup>

</Project>
